[TEMPLATE]
# ---- NASA FIRMS (required) ----
FIRMS_MAP_KEY=your-firms-map-key
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT
FIRMS_DAY_RANGE=7
FIRMS_BBOX=68.0,6.0,97.5,35.5
INGEST_INTERVAL_MINUTES=10

# ---- ML ----
USE_ML_MODEL=true
MODEL_PATH=ml/model.pkl

# ---- Alerting rule (alert log is always recorded; channels optional) ----
ALERT_MIN_CONFIDENCE=85
ALERT_RADIUS_KM=5
ALERT_COOLDOWN_HOURS=6

# ---- ntfy phone push (easiest — no account needed) ----
# Pick any topic name; install the free ntfy app and subscribe to the same
# topic. Or link live from the dashboard Settings tab.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---- Authority email ----
# Alerts are sent as formal incident notices FROM the SMTP account TO the
# authorities below (comma-separated). Or configure live from Settings.
# Gmail: SMTP_PASS is a 16-char app password (Google Account > Security >
# App passwords), not the login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AUTHORITY_EMAILS=

# ---- Address resolution for alerts (optional) ----
# Google Geocoding API key; if empty, free Nominatim/OSM fallback is used.
GOOGLE_MAPS_API_KEY=

# ---- Server ----
DB_PATH=data/fires.db
CORS_ORIGINS=http://localhost:3000
