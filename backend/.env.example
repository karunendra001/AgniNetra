# Get a free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,MODIS_NRT
FIRMS_DAY_RANGE=7
# India bounding box: west,south,east,north
FIRMS_BBOX=68.0,6.0,97.5,35.5

# Background refresh
INGEST_INTERVAL_MINUTES=10

# ML adapter: set USE_ML_MODEL=false until the model file exists
USE_ML_MODEL=false
MODEL_PATH=ml/model.pkl

DB_PATH=data/fires.db
CORS_ORIGINS=http://localhost:3000
